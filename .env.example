# Frontend (Vercel) environment variables.
# Without these, the app targets the local Supabase stack (supabase start).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from the Supabase dashboard>

# The "Add to Apple Wallet" button on the guest pass is on by default.
# Set to false to hide it (for example, where walletPass has no APPLE_* secrets).
# VITE_APPLE_WALLET_ENABLED=false
