{
  "name": "EventStaff",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Reference to event"
    },
    "staff_email": {
      "type": "string",
      "description": "Staff user email"
    },
    "staff_phone": {
      "type": "string",
      "description": "Staff user phone (alternative to email)"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff display name"
    },
    "role": {
      "type": "string",
      "enum": [
        "doorman",
        "manager"
      ],
      "default": "doorman"
    }
  },
  "required": [
    "event_id",
    "role"
  ],
  "rls": {
    "create": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    },
    "read": {
      "$or": [
        {
          "Event.data.host_email": "{{user.email}}",
          "Event.id": "$data.event_id"
        },
        {
          "data.staff_email": "{{user.email}}"
        },
        {
          "data.staff_phone": "{{user.phone}}"
        }
      ]
    },
    "update": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    },
    "delete": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    }
  }
}