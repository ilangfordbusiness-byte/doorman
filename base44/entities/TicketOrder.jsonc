{
  "name": "TicketOrder",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Reference to event"
    },
    "tier_id": {
      "type": "string",
      "description": "Reference to TicketTier"
    },
    "tier_name": {
      "type": "string"
    },
    "guest_email": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "promo_code_id": {
      "type": "string",
      "description": "Reference to PromoCode used, if any"
    },
    "promo_code": {
      "type": "string",
      "description": "Promo code text used, if any"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_price": {
      "type": "number",
      "description": "Face value per ticket in major currency units"
    },
    "discount_percent": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "description": "Total discount applied, in major currency units",
      "default": 0
    },
    "promoter_discount_amount": {
      "type": "number",
      "description": "Portion of the total discount from the promoter's auto-applied discount, major units",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "description": "Total paid by guest after discount, in major currency units"
    },
    "platform_fee": {
      "type": "number",
      "description": "Platform fee = 0.50 + 4% of paid amount, in major currency units",
      "default": 0
    },
    "commission_amount": {
      "type": "number",
      "description": "Promoter commission for this order, in major currency units",
      "default": 0
    },
    "host_net": {
      "type": "number",
      "description": "Amount due to host = paid_amount - platform_fee - commission_amount, in major currency units",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "gbp"
    },
    "promoter_id": {
      "type": "string",
      "description": "Reference to Promoter attributed for this sale, if any"
    },
    "promoter_code": {
      "type": "string",
      "description": "Promoter tracking code attributed for this sale, if any"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "guestlist_entry_id": {
      "type": "string",
      "description": "GuestlistEntry created once payment confirmed"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded",
        "cancelled"
      ],
      "default": "pending"
    },
    "refunded_at": {
      "type": "string",
      "description": "Timestamp when refund processed"
    }
  },
  "required": [
    "event_id",
    "tier_id",
    "guest_email",
    "unit_price",
    "paid_amount",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.guest_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}