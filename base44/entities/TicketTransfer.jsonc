{
  "name": "TicketTransfer",
  "type": "object",
  "properties": {
    "guestlist_entry_id": {
      "type": "string",
      "description": "The ticket (GuestlistEntry) being transferred"
    },
    "event_id": {
      "type": "string",
      "description": "Reference to event"
    },
    "event_title": {
      "type": "string",
      "description": "Event title at time of transfer (for display in lists/emails)"
    },
    "sender_email": {
      "type": "string",
      "description": "Current owner sending the ticket"
    },
    "sender_name": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string",
      "description": "Friend who will receive the ticket"
    },
    "recipient_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "cancelled"
      ],
      "default": "pending"
    },
    "accepted_at": {
      "type": "string"
    },
    "cancelled_at": {
      "type": "string"
    }
  },
  "required": [
    "guestlist_entry_id",
    "event_id",
    "sender_email",
    "recipient_email",
    "status"
  ],
  "rls": {
    "create": {
      "data.sender_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}