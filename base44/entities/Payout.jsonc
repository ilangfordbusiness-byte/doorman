{
  "name": "Payout",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user receiving the payout"
    },
    "user_id": {
      "type": "string",
      "description": "User id receiving the payout"
    },
    "role": {
      "type": "string",
      "enum": [
        "host",
        "promoter"
      ],
      "description": "Earnings role this payout is drawn from"
    },
    "amount": {
      "type": "number",
      "description": "Payout amount in major currency units"
    },
    "currency": {
      "type": "string",
      "default": "gbp"
    },
    "stripe_transfer_id": {
      "type": "string",
      "description": "Stripe Transfer id to the connected account"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "user_email",
    "amount",
    "currency",
    "status"
  ],
  "rls": {
    "create": false,
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": false,
    "delete": false
  }
}