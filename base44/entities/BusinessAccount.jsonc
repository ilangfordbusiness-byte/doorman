{
  "name": "BusinessAccount",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Personal user email that owns this business account"
    },
    "business_email": {
      "type": "string",
      "description": "Contact email for the business (used for its separate Stripe account)"
    },
    "business_name": {
      "type": "string",
      "description": "Business display name"
    },
    "business_picture": {
      "type": "string",
      "description": "Business profile picture URL"
    },
    "stripe_mode": {
      "type": "string",
      "enum": [
        "personal",
        "business"
      ],
      "default": "business",
      "description": "Whether payouts go to the owner's personal Stripe account or a separate business account"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Separate Stripe Connect account for the business (used when stripe_mode=business)"
    },
    "stripe_onboarding_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "restricted",
        "active"
      ],
      "default": "none"
    }
  },
  "required": [
    "owner_email",
    "business_email",
    "business_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}