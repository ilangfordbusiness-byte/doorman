{
  "name": "GuestlistEntry",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Reference to event"
    },
    "guest_email": {
      "type": "string",
      "description": "Guest user email"
    },
    "guest_name": {
      "type": "string",
      "description": "Guest display name"
    },
    "guest_phone": {
      "type": "string",
      "description": "Guest phone number"
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "requested",
        "approved",
        "denied",
        "waitlist",
        "checked_in",
        "revoked"
      ],
      "default": "invited"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "invite_link",
        "request"
      ],
      "default": "manual"
    },
    "plus_one": {
      "type": "boolean",
      "default": false
    },
    "plus_one_name": {
      "type": "string"
    },
    "can_chat": {
      "type": "boolean",
      "default": false,
      "description": "Whether this guest is allowed to send messages in the event chat"
    },
    "checked_in_at": {
      "type": "string",
      "description": "Timestamp when checked in"
    },
    "checked_in_by": {
      "type": "string",
      "description": "Doorman email who checked them in"
    },
    "checked_out_at": {
      "type": "string",
      "description": "Timestamp when guest left the event"
    },
    "notes": {
      "type": "string",
      "description": "Host/staff notes about this guest"
    },
    "qr_secret": {
      "type": "string",
      "description": "Secret key for QR token generation"
    }
  },
  "required": [
    "event_id",
    "guest_email",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "Event.data.host_email": "{{user.email}}",
          "Event.id": "$data.event_id"
        },
        {
          "data.guest_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.guest_email": "{{user.email}}"
        },
        {
          "Event.data.host_email": "{{user.email}}",
          "Event.id": "$data.event_id"
        },
        {
          "EventStaff.data.staff_email": "{{user.email}}",
          "EventStaff.data.event_id": "$data.event_id"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "Event.data.host_email": "{{user.email}}",
          "Event.id": "$data.event_id"
        },
        {
          "EventStaff.data.staff_email": "{{user.email}}",
          "EventStaff.data.event_id": "$data.event_id"
        }
      ]
    },
    "delete": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    }
  }
}