{
  "name": "PromoCode",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Reference to event"
    },
    "code": {
      "type": "string",
      "description": "Promo code text, stored uppercase"
    },
    "discount_percent": {
      "type": "number",
      "description": "Discount percentage applied to ticket price (0-100)",
      "default": 0
    },
    "max_uses": {
      "type": "number",
      "description": "Maximum total uses across all buyers",
      "default": 1
    },
    "used_count": {
      "type": "number",
      "description": "Number of times this code has been used",
      "default": 0
    },
    "total_discount_given": {
      "type": "number",
      "description": "Sum of discount amounts applied, in major currency units",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "exhausted",
        "disabled"
      ],
      "default": "active"
    }
  },
  "required": [
    "event_id",
    "code",
    "discount_percent",
    "max_uses"
  ],
  "rls": {
    "create": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    },
    "read": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    },
    "update": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    },
    "delete": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    }
  }
}