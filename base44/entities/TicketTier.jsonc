{
  "name": "TicketTier",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Reference to event"
    },
    "name": {
      "type": "string",
      "description": "Tier name, e.g. Early bird, General admission, VIP"
    },
    "price": {
      "type": "number",
      "description": "Price per ticket in major currency units (e.g. 20.00)"
    },
    "quantity": {
      "type": "number",
      "description": "Total tickets available for this tier",
      "default": 0
    },
    "sold": {
      "type": "number",
      "description": "Tickets sold so far",
      "default": 0
    },
    "sales_status": {
      "type": "string",
      "enum": [
        "open",
        "sold_out",
        "closed"
      ],
      "default": "open"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "event_id",
    "name",
    "price",
    "quantity"
  ],
  "rls": {
    "create": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    },
    "read": {
      "user_condition": {
        "isAuthenticated": true
      }
    },
    "update": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    },
    "delete": {
      "Event.data.host_email": "{{user.email}}",
      "Event.id": "$data.event_id"
    }
  }
}