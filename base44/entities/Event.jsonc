{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event name"
    },
    "cover_image": {
      "type": "string",
      "description": "Cover image URL"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "start_time": {
      "type": "string",
      "description": "Start time HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "End time HH:MM"
    },
    "venue_name": {
      "type": "string",
      "description": "Venue name"
    },
    "address": {
      "type": "string",
      "description": "Full address"
    },
    "venue_lat": {
      "type": "number",
      "description": "Venue latitude (geocoded)"
    },
    "venue_lng": {
      "type": "number",
      "description": "Venue longitude (geocoded)"
    },
    "dress_code": {
      "type": "string",
      "description": "Dress code"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "entry_notes": {
      "type": "string",
      "description": "Entry rules/notes"
    },
    "host_notes": {
      "type": "string",
      "description": "Notes visible only to staff"
    },
    "instagram": {
      "type": "string",
      "description": "Event/company Instagram handle (without @)"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Public or private event"
    },
    "capacity": {
      "type": "number",
      "description": "Max capacity"
    },
    "requests_open": {
      "type": "boolean",
      "default": true,
      "description": "Whether join requests are open"
    },
    "plus_one_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Allow plus ones"
    },
    "host_email": {
      "type": "string",
      "description": "Host user email"
    },
    "host_name": {
      "type": "string",
      "description": "Host display name"
    },
    "host_picture": {
      "type": "string",
      "description": "Host profile picture URL (denormalized)"
    },
    "co_hosts": {
      "type": "array",
      "description": "Co-hosts invited to help run the event",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "picture": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "declined"
            ],
            "default": "pending"
          }
        }
      },
      "default": []
    },
    "co_host_emails": {
      "type": "array",
      "description": "Emails of accepted co-hosts (plain list for access control)",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "cancelled",
        "completed"
      ],
      "default": "draft"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique shareable invite code"
    },
    "staff_code": {
      "type": "string",
      "description": "4-digit code for doormen to self-register"
    },
    "is_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether this event sells paid tickets"
    },
    "currency": {
      "type": "string",
      "default": "gbp",
      "description": "ISO currency code for ticket sales, lowercase (e.g. gbp, eur)"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "show_names",
        "count_only",
        "none"
      ],
      "default": "show_names",
      "description": "Who's-going visibility: show_names, count_only, or none"
    }
  },
  "required": [
    "title",
    "date",
    "start_time",
    "host_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.host_email": "{{user.email}}"
        },
        {
          "data.co_host_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        }
      ]
    },
    "delete": {
      "data.host_email": "{{user.email}}"
    }
  }
}