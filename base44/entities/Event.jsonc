{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event name"
    },
    "cover_image": {
      "type": "string",
      "description": "Cover image URL"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "start_time": {
      "type": "string",
      "description": "Start time HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "End time HH:MM"
    },
    "venue_name": {
      "type": "string",
      "description": "Venue name"
    },
    "address": {
      "type": "string",
      "description": "Full address"
    },
    "dress_code": {
      "type": "string",
      "description": "Dress code"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "entry_notes": {
      "type": "string",
      "description": "Entry rules/notes"
    },
    "host_notes": {
      "type": "string",
      "description": "Notes visible only to staff"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Public or private event"
    },
    "capacity": {
      "type": "number",
      "description": "Max capacity"
    },
    "requests_open": {
      "type": "boolean",
      "default": true,
      "description": "Whether join requests are open"
    },
    "plus_one_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Allow plus ones"
    },
    "host_email": {
      "type": "string",
      "description": "Host user email"
    },
    "host_name": {
      "type": "string",
      "description": "Host display name"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "cancelled",
        "completed"
      ],
      "default": "draft"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique shareable invite code"
    },
    "staff_code": {
      "type": "string",
      "description": "4-digit code for doormen to self-register"
    }
  },
  "required": [
    "title",
    "date",
    "start_time",
    "host_email"
  ]
}