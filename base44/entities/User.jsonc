{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "phone": {
      "type": "string"
    },
    "profile_picture": {
      "type": "string"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram handle (without @)"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Connected Stripe account ID for receiving ticket payouts"
    },
    "stripe_onboarding_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "restricted",
        "active"
      ],
      "default": "none",
      "description": "Status of the host's Stripe Connect onboarding"
    },
    "active_business_id": {
      "type": "string",
      "description": "BusinessAccount id the user is currently acting as (null = personal account)"
    }
  },
  "required": [
    "phone",
    "profile_picture",
    "instagram"
  ]
}